# Optional. Without these, StyleBy stores your closet in this browser's
# localStorage only. With them, closet items & outfits persist in Supabase.
#
# Get these from your Supabase project: Project Settings → API
#   - Project URL           -> VITE_SUPABASE_URL   (e.g. https://xxxx.supabase.co)
#   - anon / public API key -> VITE_SUPABASE_ANON_KEY (safe for the browser;
#     never put the service_role key in frontend code)
#
# Then run supabase/schema.sql in the Supabase SQL editor to create the
# closet_items and outfits tables.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
